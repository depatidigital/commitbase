// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applications Application[]
  logs         Log[]
  deployments  Deployment[]
  domains      Domain[]

  @@map("users")
}

model Application {
  id     String    @id @default(cuid())
  name   String
  domain String    @unique
  type   AppType
  status AppStatus @default(STOPPED)
  port   Int?
  memory String?
  cpu    String?
  uptime String?

  // Repository info
  repository String?
  branch     String? @default("main")

  // Build & runtime config
  buildCommand String?
  startCommand String?
  envVars      Json? // Store as JSON object

  // Deployment info
  lastDeployment  DateTime?
  deploymentCount Int       @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deployments     Deployment[]
  logs            Log[]
  databases       Database[]
  releases        Release[]    @relation("ApplicationReleases")
  activeReleaseId String?
  activeRelease   Release?     @relation("ActiveRelease", fields: [activeReleaseId], references: [id])

  @@map("applications")
}

model Deployment {
  id            String           @id @default(cuid())
  status        DeploymentStatus @default(PENDING)
  buildLogs     String?
  deployLogs    String?
  commitHash    String?
  commitMessage String?

  // Build metrics
  buildTime Int? // in seconds
  buildSize String? // e.g., "45MB"

  // Environment
  envVars Json? // Override env vars for this deployment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

model Release {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation("ApplicationReleases", fields: [applicationId], references: [id], onDelete: Cascade)
  imageTag      String
  commitSha     String?
  createdAt     DateTime      @default(now())
  status        ReleaseStatus @default(PENDING)
  containerId   String?
  ports         Json?
  health        String?
  logsRef       String?

  activeForApplications Application[] @relation("ActiveRelease")

  @@map("releases")
}

model Database {
  id               String         @id @default(cuid())
  name             String
  type             DatabaseType
  status           DatabaseStatus @default(CREATING)
  connectionString String?
  port             Int?
  memory           String?
  cpu              String?

  // Configuration
  version String?
  config  Json? // Database-specific configuration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("databases")
}

model Log {
  id        String   @id @default(cuid())
  level     LogLevel
  message   String
  timestamp DateTime @default(now())
  metadata  Json? // Additional log metadata

  // Relations
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("logs")
}

model Domain {
  id         String       @id @default(cuid())
  name       String       @unique
  status     DomainStatus @default(ACTIVE)
  dnsRecords Json? // Store DNS records as JSON
  sslStatus  SSLStatus    @default(PENDING)
  sslExpiry  DateTime?

  // Configuration
  redirectTo   String? // Domain redirect target
  customConfig Json? // Custom domain configuration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model SystemMetric {
  id        String     @id @default(cuid())
  type      MetricType
  value     Float
  unit      String?
  timestamp DateTime   @default(now())
  metadata  Json? // Additional metric data

  @@map("system_metrics")
}

model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, key])
  @@map("integration_configs")
}

// Enums
enum UserRole {
  ADMIN
  USER
}

enum AppType {
  NODEJS
  STATIC
  PYTHON
  GO
  RUST
  PHP
  JAVA
}

enum AppStatus {
  RUNNING
  STOPPED
  ERROR
  DEPLOYING
  BUILDING
}

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYING
  SUCCESS
  FAILED
  CANCELLED
}

enum ReleaseStatus {
  PENDING
  READY
  FAILED
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
  REDIS
  SQLITE
}

enum DatabaseStatus {
  CREATING
  RUNNING
  STOPPED
  ERROR
}

enum DomainStatus {
  ACTIVE
  INACTIVE
  PENDING
  ERROR
}

enum SSLStatus {
  PENDING
  ACTIVE
  EXPIRED
  ERROR
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum MetricType {
  CPU_USAGE
  MEMORY_USAGE
  DISK_USAGE
  NETWORK_IN
  NETWORK_OUT
  APP_COUNT
  DEPLOYMENT_COUNT
}
