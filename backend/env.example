# Database
DATABASE_URL="postgresql://username:password@localhost:5432/commitbase"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-here"

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Frontend URL (used for OAuth redirects, falls back to CORS_ORIGIN if not set)
FRONTEND_URL="http://localhost:5173"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# GitLab OAuth
GITLAB_CLIENT_ID="your-gitlab-client-id"
GITLAB_CLIENT_SECRET="your-gitlab-client-secret"
# Optional: override GitLab base URLs for self-hosted instances
GITLAB_OAUTH_BASE="https://gitlab.com/oauth"
GITLAB_API_BASE="https://gitlab.com/api/v4"

# Applications Directory
APPS_DIR="./apps_dir"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info 

# Scheduled integration sync (node-cron). CRON_ENABLED=false turns it off.
CRON_ENABLED=true
CRON_DOMAIN_SYNC="0 3 * * *"

# Where domains and subdomains point — this server's public IP (A record)
# or a hostname (CNAME). Takes precedence over the value stored in the database.
SERVER_IP="203.0.113.10"
