// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applications Application[]
  logs        Log[]
  deployments Deployment[]
  domains     Domain[]
  gitAccounts GitAccount[]
  memberships Membership[]
  invitesSent Invite[]     @relation("InvitedBy")

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Which provisioning node this org's OS user, home and apps live on.
  // Nullable only until the backfill has run; treat a null as "not yet placed"
  // and refuse to provision rather than guessing a node.
  serverId  String?
  server    Server?  @relation(fields: [serverId], references: [id])

  // Which database server this org's databases are created on, per engine.
  // Same rule as serverId: null means "not placed", and creating a database
  // is refused rather than guessing a server.
  postgresServerId String?
  postgresServer   DatabaseServer? @relation("OrgPostgresServer", fields: [postgresServerId], references: [id])
  mysqlServerId    String?
  mysqlServer      DatabaseServer? @relation("OrgMysqlServer", fields: [mysqlServerId], references: [id])

  // OS provisioning queue (orgProvisionService). Requests only flag the row;
  // the worker runs cb-provision-org over SSH and records the outcome here.
  // A QUEUED org with no server waits until it is placed.
  provisionState ProvisionState @default(NONE)
  provisionError String?
  /// Tail of cb-provision-org's output, written while it runs (live view) and kept after
  provisionLog   String?
  /// { userId, trigger, diskQuota?, cpuQuota?, memoryMax? } of the pending request
  provisionJob   Json?
  provisionedAt  DateTime?

  members          Membership[]
  domains          Domain[]
  applications     Application[]
  invites          Invite[]
  databases        Database[]
  databaseAccounts OrgDatabaseAccount[]

  @@index([serverId])
  @@index([provisionState])
  @@map("organizations")
}

enum ProvisionState {
  NONE
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A provisioning node. The control plane owns no boxes of its own — it reaches
/// every node, including the VM it runs on, over SSH.
/// 
/// Every column here was a single-server environment variable before this
/// model existed; they are per-box config, not per-install config. Settings
/// that are genuinely the same on every node (home root, port pool, quota
/// defaults) stay in the environment — a column per node would be one more
/// thing to keep in sync for no gain.
model Server {
  id            String   @id @default(cuid())
  name          String
  /// SSH target - hostname or IP. The control plane's own VM is a row like any other.
  hostname      String
  sshUser       String   @default("larika")
  sshPort       Int      @default(22)
  /// How the control plane authenticates to this node. A key is the default and
  /// the one to prefer; PASSWORD exists for boxes where installing a key is not
  /// an option (a managed VPS, a first connection before the key is in place).
  authMethod    String   @default("KEY")
  /// Path to the private key ON THE CONTROL PLANE. Never key material in the
  /// database. Required when authMethod is KEY.
  sshKeyPath    String?
  /// AES-256-GCM ciphertext of the SSH password, never the password itself.
  /// Required when authMethod is PASSWORD. Never leaves the backend.
  sshPassword   String?
  /// Public address for this node's apps. Becomes the Cloudflare A record target.
  publicIp      String
  /// Free-form labels — "production", "jakarta", "php8.3". Grouping a growing
  /// fleet is the operator's own vocabulary, not something to model as columns.
  tags          String[]
  /// Deprecated: the Caddy admin API is unauthenticated, so it is never
  /// addressed directly. Each node's is reached at its own 127.0.0.1:2019
  /// through the SSH connection above. Kept only so an existing row survives;
  /// drop the column once nothing reads it.
  caddyApiUrl   String   @default("")

  /// ONLINE, OFFLINE or UNKNOWN, from the heartbeat. With more than one node,
  /// "the panel cannot reach this box" is a state an admin has to be able to
  /// see before a tenant reports it.
  status        String    @default("UNKNOWN")
  /// Whether the panel can become root on this node (the runner scripts are
  /// sent over SSH, so that is all "set up" needs). Separate from status on purpose: a box can be perfectly reachable and simply not set up
  /// yet, and those two problems have completely different fixes.
  provisioned   Boolean   @default(false)
  lastSeenAt    DateTime?
  /// Why the last heartbeat failed. Kept so the failure is diagnosable from
  /// the UI without shell access to either machine.
  lastError     String?

  /// Node setup queue (serverSetupService): the panel runs install.sh
  /// over SSH. Same states as an organization's provisioning.
  setupState    ProvisionState @default(NONE)
  setupError    String?
  /// Unused since PHP-FPM is always installed (was { withPhp }). Kept so existing rows survive.
  setupJob      Json?
  /// Tail of the last setup run's output.
  setupLog      String?
  setupAt       DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizations   Organization[]
  applications    Application[]
  databaseServers DatabaseServer[]

  @@map("servers")
}

/// A Postgres or MySQL instance tenant databases are created on.
///
/// Either on one of our nodes — bound to its loopback or private address and
/// reached through that node's SSH connection, so no database port is public —
/// or a managed service reached directly over TLS. The admin login is the one
/// the control plane creates roles and databases with; it should be able to do
/// exactly that and no more (CREATEROLE + CREATEDB, not a superuser).
model DatabaseServer {
  id               String       @id @default(cuid())
  name             String
  /// POSTGRESQL or MYSQL — the other DatabaseType values are not servers
  engine           DatabaseType
  mode             DbServerMode @default(TUNNEL)
  /// TUNNEL: the node the engine runs on. host/port are then as seen from that
  /// node, usually 127.0.0.1.
  serverId         String?
  server           Server?      @relation(fields: [serverId], references: [id], onDelete: Restrict)
  host             String
  port             Int
  /// DISABLE, REQUIRE (encrypt, no certificate check) or VERIFY (check the
  /// certificate against caCert or the system roots). A DIRECT server never
  /// runs DISABLE — its traffic crosses networks we do not own.
  tlsMode          String       @default("REQUIRE")
  caCert           String?
  adminUser        String
  /// AES-256-GCM ciphertext (secretBox). Never leaves the backend.
  adminPasswordEnc String
  /// The address apps connect to — a private IP or localhost for a node, the
  /// public host for a managed service. Separate from host because the control
  /// plane and the apps rarely see the server from the same place.
  appHost          String
  /// ONLINE, OFFLINE or UNKNOWN, from the health check
  status           String       @default("UNKNOWN")
  version          String?
  /// What the admin login may do, from the last check, e.g. "createrole,createdb"
  adminRights      String?
  lastSeenAt       DateTime?
  lastError        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  accounts     OrgDatabaseAccount[]
  databases    Database[]
  users        DatabaseUser[]
  postgresOrgs Organization[]       @relation("OrgPostgresServer")
  mysqlOrgs    Organization[]       @relation("OrgMysqlServer")

  @@index([serverId])
  @@map("database_servers")
}

/// The organization's login on one database server — created with the org's
/// first database there, and the owner of every database it has on it.
model OrgDatabaseAccount {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  databaseServerId String
  databaseServer   DatabaseServer @relation(fields: [databaseServerId], references: [id], onDelete: Restrict)
  /// org_<slug> — the role/user name on the server
  username         String
  /// AES-256-GCM ciphertext (secretBox)
  passwordEnc      String
  createdAt        DateTime       @default(now())
  rotatedAt        DateTime?

  @@unique([organizationId, databaseServerId])
  @@map("org_database_accounts")
}

/// A login/role that exists on a database server — a mirror of the server,
/// rewritten by every inventory sync. The panel does not manage these; it
/// shows who can reach what. Organizations' own logins are OrgDatabaseAccount.
model DatabaseUser {
  id               String         @id @default(cuid())
  databaseServerId String
  databaseServer   DatabaseServer @relation(fields: [databaseServerId], references: [id], onDelete: Cascade)
  username         String
  /// MySQL account host ('%', 'localhost', …); empty for Postgres roles
  host             String         @default("")
  canLogin         Boolean        @default(true)
  superuser        Boolean        @default(false)
  /// Databases it owns or was explicitly granted access to
  databases        String[]
  lastSeenAt       DateTime       @default(now())

  @@unique([databaseServerId, username, host])
  @@map("database_users")
}

enum DbServerMode {
  TUNNEL
  DIRECT
}

model Membership {
  id             String   @id @default(cuid())
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invite {
  id             String    @id @default(cuid())
  email          String
  role           OrgRole   @default(MEMBER)
  tokenHash      String    @unique // sha256 of the token; the raw token is shown once
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String?
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invites")
}

model Application {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  type        AppType
  status      AppStatus @default(STOPPED)
  port        Int?
  memory      String?
  cpu         String?
  uptime      String?
  
  // Repository info
  repository  String?
  branch      String? @default("main")
  
  // Build & runtime config
  buildCommand String?
  startCommand String?
  envVars     Json? // Store as JSON object
  
  // Static sites: the R2 bucket holding the files and the public host Caddy
  // proxies to (Cloudflare caches in front of it)
  staticBucket String?
  staticOrigin String?

  // Deployment info
  lastDeployment DateTime?
  deploymentCount Int @default(0)

  // Server inventory — filled by the app sync (pm2 + Caddy site files)
  runtime      String?   // "PM2" | "CADDY_PHP" | "CADDY_STATIC" | "CADDY_PROXY" | null for apps we deploy
  processName  String?   // pm2 process name, when the runtime is PM2
  rootPath     String?   // document root / working directory on the server
  configPath   String?   // /etc/caddy/sites/<name>.caddy
  lastSyncedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations — organization owns the app; user is the creator (audit only)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Which connected git account clones this app's repository. Null for public
  // repos and uploads. SetNull on delete: disconnecting an account must not
  // take the applications with it, it only makes the next deploy ask for a
  // reconnect.
  gitAccountId String?
  gitAccount   GitAccount? @relation(fields: [gitAccountId], references: [id], onDelete: SetNull)

  deployments Deployment[]
  logs        Log[]
  databases   Database[]
  releases    Release[] @relation("ApplicationReleases")
  activeReleaseId String?
  activeRelease   Release? @relation("ActiveRelease", fields: [activeReleaseId], references: [id])

  // Which node this app actually runs on. Set by the server sync for apps
  // discovered on a box; deploys still follow the organization's placement, so
  // this is "where it was found", not "where it belongs".
  serverId     String?
  server       Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  // Parent domain this app's hostname lives under (ownership boundary)
  domainId     String?
  parentDomain Domain? @relation("DomainApplications", fields: [domainId], references: [id])

  @@index([userId])
  @@index([domainId])
  @@index([gitAccountId])
  @@index([organizationId])
  @@map("applications")
}

model Deployment {
  id          String   @id @default(cuid())
  status      DeploymentStatus @default(PENDING)
  buildLogs   String?
  deployLogs  String?
  commitHash  String?
  commitMessage String?
  
  // Build metrics
  buildTime   Int? // in seconds
  buildSize   String? // e.g., "45MB"
  
  // Environment
  envVars     Json? // Override env vars for this deployment
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

model Release {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation("ApplicationReleases", fields: [applicationId], references: [id], onDelete: Cascade)
  imageTag      String?  // legacy: image reference from the removed Docker runtime
  commitSha     String?
  createdAt     DateTime      @default(now())
  status        ReleaseStatus @default(PENDING)
  containerId   String?
  ports         Json?
  health        String?
  logsRef       String?
  path          String?       // releases/<stamp> directory this release was built into

  @@map("releases")

  activeForApplications Application[] @relation("ActiveRelease")
}

model Database {
  id          String   @id @default(cuid())
  name        String
  type        DatabaseType
  status      DatabaseStatus @default(CREATING)
  connectionString String?
  port        Int?
  memory      String?
  cpu         String?
  
  // Configuration
  version     String?
  config      Json? // Database-specific configuration
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  // Optional: a database belongs to its organization, and one found on a
  // server by the inventory sync has no app at all until it is attached.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // The org the database belongs to and the server it lives on. Nullable until
  // databases are created for real: rows from before database servers carry no
  // server, and the backfill fills organizationId from their application.
  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  databaseServerId String?
  databaseServer   DatabaseServer? @relation(fields: [databaseServerId], references: [id], onDelete: Restrict)
  /// The database's real name on the server, <slug>_<name>
  dbName           String?
  /// Found on the server by the inventory sync rather than created by us.
  /// Unassigned until a superadmin gives it an organization.
  discovered       Boolean         @default(false)
  /// On-disk size from the last sync, in bytes
  sizeBytes        Float?
  /// Why the last create or drop on the server failed — shown on the row, cleared on success
  lastError        String?

  @@unique([databaseServerId, dbName])
  @@index([organizationId])
  @@index([databaseServerId])
  @@map("databases")
}

model Log {
  id          String   @id @default(cuid())
  level       LogLevel
  message     String
  timestamp   DateTime @default(now())
  metadata    Json? // Additional log metadata
  
  // Relations
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("logs")
}

model Domain {
  id          String   @id @default(cuid())
  name        String   @unique
  status      DomainStatus @default(ACTIVE)
  dnsRecords  Json? // Store DNS records as JSON
  sslStatus   SSLStatus @default(PENDING)
  sslExpiry   DateTime?
  
  // Configuration
  redirectTo  String? // Domain redirect target
  customConfig Json? // Custom domain configuration

  // Where the domain comes from — filled by the integrations sync
  registrar    String?   // "RDASH" | "EXTERNAL" | null when unknown
  cfZoneId     String?   // set when a Cloudflare zone exists for it
  expiresAt    DateTime? // domain registration expiry, from the registrar
  lastSyncedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  applications Application[] @relation("DomainApplications")

  @@index([userId])
  @@index([organizationId])
  @@map("domains")
}

model SystemMetric {
  id          String   @id @default(cuid())
  type        MetricType
  value       Float
  unit        String?
  timestamp   DateTime @default(now())
  metadata    Json? // Additional metric data

  @@map("system_metrics")
}

model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, key])
  @@map("integration_configs")
}

model GitAccount {
  id          String   @id @default(cuid())
  provider    String   // "github" or "gitlab"
  externalId  String   // provider user ID
  username    String
  displayName String
  accessToken String
  /// GitLab access tokens expire (2h); GitHub OAuth App tokens do not. Both
  /// columns stay null for GitHub.
  refreshToken   String?
  tokenExpiresAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]

  @@unique([userId, provider, externalId])
  @@map("git_accounts")
}

// Enums
// Platform-level role. SUPERADMIN = platform owner (integrations config).
// ADMIN = operator of Larika itself.
enum UserRole {
  SUPERADMIN
  ADMIN
  USER
  CLIENT
}

// Role inside a single organization.
enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum AppType {
  NODEJS
  STATIC
  PYTHON
  GO
  RUST
  PHP
  JAVA
}

enum AppStatus {
  RUNNING
  STOPPED
  ERROR
  DEPLOYING
  BUILDING
}

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYING
  SUCCESS
  FAILED
  CANCELLED
}

enum ReleaseStatus {
  PENDING
  READY
  FAILED
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
  REDIS
  SQLITE
}

enum DatabaseStatus {
  CREATING
  RUNNING
  STOPPED
  ERROR
}

enum DomainStatus {
  ACTIVE
  INACTIVE
  PENDING
  ERROR
}

enum SSLStatus {
  PENDING
  ACTIVE
  EXPIRED
  ERROR
}

/// Caddy keeps its configuration in memory, and the site files that used to
/// back it are gone. A reload from the Caddyfile would otherwise take every
/// tenant route with it — including PHP sockets and document roots that are
/// written down nowhere else — so the live config is snapshotted here and
/// pushed back when routes go missing.
/// One check result for one thing we watch — an application's hostname or a
/// node's SSH reachability.
///
/// Every check the platform already runs answered a question and threw the
/// answer away, so "is it up?" could be answered but "has it been flapping
/// since Tuesday?" could not. These rows are that history, and they are what
/// the heartbeat bars and uptime percentages are drawn from.
model Heartbeat {
  id         String   @id @default(cuid())
  /// "APPLICATION" or "SERVER" — kept as a pair rather than two nullable
  /// foreign keys so one index serves every kind of target.
  targetType String
  targetId   String
  at         DateTime @default(now())
  ok         Boolean
  /// Round trip in milliseconds, when the check measured one.
  responseMs Int?
  /// HTTP status, or null for checks that are not HTTP.
  httpStatus Int?
  /// Why it failed, in the words of whatever did the checking.
  error      String?

  @@index([targetType, targetId, at])
  @@map("heartbeats")
}

model CaddySnapshot {
  id        String   @id @default(cuid())
  /// The node this config belongs to. Each node runs its own Caddy, so a
  /// snapshot is only ever restorable onto the box it came from.
  serverId  String
  config    Json
  hosts     String[]
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
  @@map("caddy_snapshots")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum MetricType {
  CPU_USAGE
  MEMORY_USAGE
  DISK_USAGE
  NETWORK_IN
  NETWORK_OUT
  APP_COUNT
  DEPLOYMENT_COUNT
} 
