# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commitbase?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
APPS_DIR="../apps_dir"
LOG_LEVEL=info 
# IDCloudHost S3 Configuration
S3_ENDPOINT="https://is3.cloudhost.id"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID="BEQWM0GW9MS7VOHT13H6"
S3_SECRET_ACCESS_KEY="zNT0JDqdEIlLOCrTVfNkek5jl1d9z0J7RktL9BE1"
S3_BUCKET_NAME="commitbase"
S3_ROOT_DIR=""

# Frontend URL (used for OAuth redirect targets)
FRONTEND_URL="http://localhost:5173"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# GitLab OAuth
GITLAB_CLIENT_ID="your-gitlab-client-id"
GITLAB_CLIENT_SECRET="your-gitlab-client-secret"

