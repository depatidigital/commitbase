# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commitbase?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
APPS_DIR="../apps_dir"
LOG_LEVEL=info 
# IDCloudHost S3 Configuration
S3_ENDPOINT="https://is3.cloudhost.id"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID="BEQWM0GW9MS7VOHT13H6"
S3_SECRET_ACCESS_KEY="zNT0JDqdEIlLOCrTVfNkek5jl1d9z0J7RktL9BE1"
S3_BUCKET_NAME="commitbase"
S3_ROOT_DIR=""

# Cloudflare R2 — static sites (one bucket per app, served through the CDN)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# bucket names are R2_BUCKET_PREFIX + the app hostname
R2_BUCKET_PREFIX="site-"

# Frontend URL (used for OAuth redirect targets)
FRONTEND_URL="http://localhost:5173"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# GitLab OAuth
GITLAB_CLIENT_ID="your-gitlab-client-id"
GITLAB_CLIENT_SECRET="your-gitlab-client-secret"

# Optional overrides for self-hosted GitLab
# GITLAB_OAUTH_BASE="https://gitlab.com/oauth"
# GITLAB_API_BASE="https://gitlab.com/api/v4"

# Scheduled integration sync (node-cron). CRON_ENABLED=false turns it off.
CRON_ENABLED=true
CRON_DOMAIN_SYNC="0 3 * * *"

# Where domains and subdomains point — this server's public IP (A record)
# or a hostname (CNAME). Takes precedence over the value stored in the database.
SERVER_IP="203.0.113.10"

APP_URL="http://localhost:8080"

# Runtime app ports are handed out from this pool, one per app for life.
# APP_PORT_POOL_START="20000"
# APP_PORT_POOL_END="29999"
# How long a deploy waits for the app to answer on $PORT before rolling back.
# APP_HEALTH_TIMEOUT_MS="60000"
# Builds run in their own cgroup (cb-build.slice) so they cannot starve the
# apps that are serving. Memory ceiling, CPU/IO weight (100 = normal) and how
# many builds may run at once.
# BUILD_MEMORY_MAX="2G"
# BUILD_CPU_WEIGHT="50"
# BUILD_CONCURRENCY="1"
# System-wide nvm (production-setup.md step 1). run.sh / build.sh source it to
# pick the Node version from .nvmrc / engines. Unset or missing = system node.
# NVM_DIR="/opt/nvm"
