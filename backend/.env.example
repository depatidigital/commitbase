# Backend environment. Copy to .env and fill in.
# Full reference: docs/production-setup.md step 5.
# Commented-out lines show the default the backend uses when the var is unset.

# --- Required -----------------------------------------------------------------
DATABASE_URL="postgresql://larika:password@localhost:5432/larika?schema=public"
# openssl rand -hex 48 — rotating it logs everyone out
JWT_SECRET=""
# JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development

# Exact origin of the panel frontend
CORS_ORIGIN="http://localhost:5173"
# OAuth redirect target; falls back to CORS_ORIGIN
FRONTEND_URL="http://localhost:5173"
# Turns invite tokens into full links; also the default ACME contact domain for nodes
APP_URL="http://localhost:5173"

# Public IP (A record) or hostname (CNAME) tenant DNS points at.
# Takes precedence over the value stored in the database.
SERVER_IP="203.0.113.10"

# --- Nodes / SSH --------------------------------------------------------------
# Each Server row has its own key path or password; these are only defaults.
# The panel's default key: its .pub is what Servers -> Set up authorizes on a
# node, and the seeded first server uses it.
# CB_SSH_KEY_PATH="/opt/larika/.ssh/id_ed25519"
# Every Server row's sshKeyPath must sit inside this dir (a fence, so a form
# cannot point the runner at /etc/shadow). Defaults to CB_SSH_KEY_PATH's dir.
# CB_SSH_KEY_DIR="/opt/larika/.ssh"
# Encryption key for secrets stored in the database (SSH passwords for nodes
# registered with password auth). 32 bytes: openssl rand -base64 32
# Without it, password auth is refused and key auth is unaffected.
CB_SECRET_KEY=""
# Let's Encrypt contact written into each node's Caddyfile by Servers -> Set up.
# Unset = admin@<APP_URL host>.
# ACME_EMAIL=""

# --- Per-organization OS isolation --------------------------------------------
# Each organization gets a Linux user cb-<slug>, its own /home/cb-<slug>, a disk
# quota, a systemd cgroup slice and (when PHP-FPM is installed) its own pool.
# The runner scripts are sent over SSH on every call, nothing is installed on
# the node. Always on: tenant apps build and run on their organization's node,
# never on the machine running this backend (static sites build here, R2 serves).
# CB_HOME_ROOT="/home"
# ORG_DISK_QUOTA="20G"
# ORG_CPU_QUOTA="50%"
# ORG_MEMORY_MAX="1G"
# PHP_FPM_SOCKET_DIR="/run/php"

# --- Deploys and builds -------------------------------------------------------
# Runtime app ports are handed out from this pool, one per app for life.
# APP_PORT_POOL_START="20000"
# APP_PORT_POOL_END="29999"
# How long a deploy waits for the app to answer on $PORT before rolling back.
# APP_HEALTH_TIMEOUT_MS="60000"
# Builds run in their own cgroup (cb-build.slice) so they cannot starve the
# apps that are serving. Memory ceiling, CPU/IO weight (100 = normal) and how
# many builds may run at once.
# BUILD_MEMORY_MAX="2G"
# BUILD_CPU_WEIGHT="50"
# BUILD_CONCURRENCY="1"
# System-wide nvm on the node. run.sh / build.sh source it to pick the Node
# version from .nvmrc / engines. Unset or missing = system node.
# NVM_DIR="/opt/nvm"
# Legacy flat app directory — only for apps with no organization
# APPS_DIR="./apps_dir"

# --- App inventory (imported, pre-existing sites) -----------------------------
# Document root guessed for synced sites
# APPS_ROOT_DIR="/var/www/html"
# The panel's own hostname, so inventory does not import it as an app
# PANEL_HOST=""

# --- Scheduler (node-cron, runs inside the backend) ---------------------------
# CRON_ENABLED=false turns every job off (local dev, one-off containers).
CRON_ENABLED=true
# TZ="UTC"
# CRON_SERVER_HEALTH="*/5 * * * *"
# CRON_DOMAIN_SYNC="0 3 * * *"
# CRON_DOMAIN_EXPIRY="0 4 * * *"
# CRON_DOMAIN_PROVISION="* * * * *"
# CRON_APP_INVENTORY="*/10 * * * *"
# CRON_APP_HTTP_CHECK="* * * * *"
# CRON_HEARTBEAT_PRUNE="30 4 * * *"
# CRON_CADDY_ROUTES="*/5 * * * *"
# CRON_ORG_PROVISION="* * * * *"
# CRON_SERVER_SETUP="* * * * *"
# HEARTBEAT_RETENTION_DAYS="7"

# --- Tenant databases ---------------------------------------------------------
# Connection limit for each organization's database role
# DB_ORG_CONNECTION_LIMIT="20"

# --- Git integrations ---------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
# Self-hosted GitLab
# GITLAB_OAUTH_BASE="https://gitlab.com/oauth"
# GITLAB_API_BASE="https://gitlab.com/api/v4"

# --- Cloudflare R2 — static sites (one bucket per app, served through the CDN) -
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# bucket names are R2_BUCKET_PREFIX + the app hostname
R2_BUCKET_PREFIX="site-"
# Falls back for R2_ACCOUNT_ID
# CLOUDFLARE_ACCOUNT_ID=""

# --- Cloudflare DNS -----------------------------------------------------------
# API token and zone id are NOT env vars — set them on the Integrations page.
# Override the DNS target and the nameservers domains are expected to use.
# CLOUDFLARE_DNS_TARGET=""
# CLOUDFLARE_NS1=""
# CLOUDFLARE_NS2=""
# CLOUDFLARE_NS3=""
# CLOUDFLARE_NS4=""

# --- S3 — build-log archive ---------------------------------------------------
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_ROOT_DIR=""

# --- Email (invites). Unset = the invite link is only shown in the UI ---------
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# MAIL_FROM="no-reply@example.com"
# APP_NAME="Larika"

# --- OpenAI (optional: AI domain name suggestions in the register flow) -------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- seedServer.ts (npm run db:seed-server) -----------------------------------
# SEED_SERVER_HOSTNAME="127.0.0.1"
# SEED_SERVER_NAME="primary"
# SEED_SERVER_SSH_USER="larika"
# SEED_SERVER_SSH_PORT="22"
